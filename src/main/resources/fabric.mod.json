{
  "schemaVersion": 1,
  "id": "directsync",
  "version": "${version}",
  "name": "Direct Sync",
  "description": "Checks and downloads server mods before login, then can restart and reconnect the client.",
  "authors": ["SupersNetwork"],
  "license": "MIT",
  "environment": "*",
  "mixins": ["directsync.mixins.json"],
  "entrypoints": {
    "main": ["net.supersnetwork.direct_sync.DirectSyncMod"],
    "client": ["net.supersnetwork.direct_sync.DirectSyncClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
